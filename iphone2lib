#!/usr/bin/bash

if [ ! -x "$(command -v exiftool)" ]; then
    echo "Requirement unmet: exiftool"
    exit 1
fi

usage() {
    echo "Usage: $0 dcim_src_dir dest_dir"
    echo "  dcim_src_dir/ should contain 100APPLE/, etc."
    echo "  100APPLE/ should contain raw images/videos"
}

if [ $# -lt 2 ] || [ ! -d "$1" ] || [ ! -d "$2" ]; then
    usage
    exit 1
fi

dcim_src_dir=$1
dst_dir=$2

# copy file to /tmp
# HDD is slow; multiple read/probe on tmpfs to speedup
tfile=$(mktemp)
chmod 644 "$tfile"

# init base timestamp
# $baseTS is monotonically increasing through time
# if file does not have time in EXIF, use $baseTS
# the output files should not have year 2000
# unless the first file does not have EXIF (unlikely)
baseTS="2000-01-01 00:00:00"

# Live Photo pairing memory.
# An Apple Live Photo is a still (.HEIC/.JPG) plus a .MOV that share a Content
# Identifier UUID. The still carries the true capture time; the video's own
# time can differ (and be mis-bucketed). To keep a pair together under one
# timestamp/folder, we remember each still's UUID -> timestamp as we stream,
# and when a video with a known UUID appears we reuse the still's timestamp.
# POSIX sh has no associative arrays, so we use a tmp file of "uuid<TAB>ts".
# Apple names the pair with the same basename in the same folder and ls lists
# the still (.HEIC) just before the video (.MOV), so the still is normally seen
# first. If a video is seen before its still, it simply uses its own time.
lpfile=$(mktemp)
chmod 644 "$lpfile"

# do not split on space when read a line
IFS=

# do not use `find`, which does not keep order
# use `while read` with `IFS=` for while space in filename
# use process substitution to enable global variable $baseTS
while read -r dname
do
    src_dir=$dcim_src_dir/$dname
    if [ -d "$src_dir" ]; then
        echo ">>> $src_dir"
        while read -r fname
        do
            ext=$(echo ${fname##*.} | tr '[:upper:]' '[:lower:]')
            if [ -f "$src_dir/$fname" ] && [ -n "$ext" ]; then
                cp "$src_dir/$fname" "$tfile"
                # Select an explicit, timezone-consistent timestamp tag.
                # Tag priority (first present wins):
                #   CreationDate      - QuickTime (video); carries the camera's
                #                       offset, so it is local wall-clock. The
                #                       plain CreateDate for video is UTC and
                #                       would mis-bucket by the UTC offset.
                #   DateTimeOriginal  - photos: "when the shot was taken".
                #   CreateDate        - last-resort fallback.
                # -d normalizes all of them to the same local wall-clock format,
                # so photos and videos land on one clock. -s3 prints value only.
                currTS=$(exiftool -s3 -d '%Y-%m-%d %H:%M:%S' \
                    -CreationDate -DateTimeOriginal -CreateDate "$tfile" \
                    | head -n 1)
                date -d "$currTS" > /dev/null 2>&1  # for test purpose
                if [ $? -eq 0 ] && [ -n "$currTS" ]; then
                    baseS=$(date -d "$baseTS" +%s)
                    currS=$(date -d "$currTS" +%s)
                    if [ "$baseS" -le "$currS" ]; then
                        baseTS=$currTS
                        timeop="->"
                    else
                        # earlier time found
                        timeop="<-"
                    fi
                else
                    currTS=$baseTS
                    timeop="  "
                fi

                # Live Photo pairing by Content Identifier UUID.
                uuid=$(exiftool -s3 -ContentIdentifier "$tfile" 2>/dev/null \
                    | head -n 1 | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
                if [ -n "$uuid" ]; then
                    case "$ext" in
                        mov|mp4|m4v)
                            # video: if we have already seen the paired still,
                            # reuse the still's timestamp so the pair shares a
                            # name/folder. baseTS bookkeeping above is left as
                            # computed from the video's own reading.
                            stillTS=$(grep -F "$uuid	" "$lpfile" \
                                | head -n 1 | cut -f 2-)
                            if [ -n "$stillTS" ]; then
                                currTS=$stillTS
                                timeop="LP"
                            fi
                            ;;
                        *)
                            # still: record its timestamp for a later video.
                            # (one line per uuid; first still wins)
                            if ! grep -qF "$uuid	" "$lpfile"; then
                                printf '%s\t%s\n' "$uuid" "$currTS" >> "$lpfile"
                            fi
                            ;;
                    esac
                fi

                # CheckSum Suffix
                css=$(sha1sum "$tfile" | cut -c 1-8)
                year=$(date -d "$currTS" +%Y)
                month=$(date -d "$currTS" +%m)
                dstname=$(date -d "$currTS" +%Y%m%d-%H%M%S-$css.$ext)
                mkdir -p "$dst_dir/$year/$month"
                if [ -f "$dst_dir/$year/$month/$dstname" ]; then
                    csx=$(sha1sum "$tfile" | awk '{print $1}')
                    csy=$(sha1sum "$dst_dir/$year/$month/$dstname" | awk '{print $1}')
                    if [ "$csx" = "$csy" ]; then
                        # duplicate found
                        act="  "
                    else
                        act="!!"
                        echo "SHA1 prefix collision: $src_dir/$fname " >&2
                    fi
                else
                    act="@@"
                    cp "$tfile" "$dst_dir/$year/$month/$dstname"
                fi
                echo "$act $timeop $currTS $fname"
            else
                echo "Unknown file: $src_dir/$fname" >&2
            fi
        done < <(ls -1 "$src_dir")
        echo ""
    else
        echo "Invalid directory: $src_dir" >&2
    fi
done < <(ls -1 "$dcim_src_dir")

rm -f "$tfile" "$lpfile"
